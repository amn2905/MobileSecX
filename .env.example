# ==============================================================================
# MobileSecX - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local to customize your local development settings.
# All Vite environment variables must be prefixed with VITE_.

# FastAPI Backend Gateway Base URL
# Default: http://localhost:8000/api
# When offline or unreachable, MobileSecX automatically falls back to Demo Mode.
VITE_API_BASE_URL=http://localhost:8000/api
